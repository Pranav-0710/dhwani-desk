# Copy to .env and fill in. Never commit .env.

# Gnani speech APIs (app.gnani.ai/voice -> API keys)
GNANI_API_KEY=
GNANI_STT_LANG=kn-IN
GNANI_STT_SAMPLE_RATE=8000
GNANI_STT_FORMAT=transcribe
GNANI_STT_BIAS_SCORE=1.0
GNANI_TTS_LANG=kn-IN
GNANI_TTS_VOICE=Saanvi
GNANI_TTS_SAMPLE_RATE=16000
GNANI_TTS_SPEED=1.0

# Hugging Face Hub: organization Dhwanidesk, both repos private (see STRUCTURE.md).
# On the laptop a read token is enough. Kaggle / Colab use a write token from notebook
# secrets, never from this file.
HF_TOKEN=
HF_DATASET_REPO=Dhwanidesk/dhwani-desk-data
LAYA_CHECKPOINT_REPO=Dhwanidesk/dhwani-desk-laya
# A tag or commit of LAYA_CHECKPOINT_REPO, never main, so a new upload cannot change a running build
LAYA_CHECKPOINT_REVISION=

# Who decides on the caller's words: keyword (rules, no model) or laya (the checkpoint above,
# exported to ONNX; needs `uv sync --group laya` in backend/). LAYA_CHECKPOINT_REPO may also be
# a local directory with the same layout, for trying an export before it is uploaded.
DECIDER=keyword
# Docker only: 1 builds the backend image with the Laya runtime, for DECIDER=laya (docs/runbook.md).
LAYA=0
# ONNX Runtime threads; 8 was fastest on the Core Ultra 7 155H (docs/decisions/laya-latency.md)
LAYA_THREADS=8

# Backend
# Pages that may open the call sockets (/ws/stt, /ws/call), comma-separated: scheme, host and
# port, as the browser sends them in Origin. Add the tunnel's https address before sharing it.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Calls streaming to Prisma at once, on our Gnani key; one more is refused with "the line is
# busy". Counted per backend process.
MAX_STT_SESSIONS=2
# Shared secret the supervisor console sends before it may watch or take over calls; long and
# random. Empty turns the console socket off.
CONSOLE_TOKEN=
DATABASE_URL=sqlite:///./dhwani.db
TRANSCRIPT_RETENTION_DAYS=7
