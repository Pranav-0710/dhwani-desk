# Copy to .env and fill in. Never commit .env.

# Gnani speech APIs (app.gnani.ai/voice -> API keys)
GNANI_API_KEY=
GNANI_STT_LANG=kn-IN
GNANI_STT_SAMPLE_RATE=8000
GNANI_STT_FORMAT=transcribe
GNANI_STT_BIAS_SCORE=1.0
GNANI_TTS_LANG=kn-IN
GNANI_TTS_VOICE=Saanvi
GNANI_TTS_SAMPLE_RATE=16000
GNANI_TTS_SPEED=1.0

# Hugging Face Hub: organization Dhwanidesk, both repos private (see STRUCTURE.md).
# On the laptop a read token is enough. Kaggle / Colab use a write token from notebook
# secrets, never from this file.
HF_TOKEN=
HF_DATASET_REPO=Dhwanidesk/dhwani-desk-data
LAYA_CHECKPOINT_REPO=Dhwanidesk/dhwani-desk-laya
# A tag or commit of LAYA_CHECKPOINT_REPO, never main, so a new upload cannot change a running build.
# kn-ft-v1: fine-tuned on the Kannada set (#14), scored in eval/reports/.
LAYA_CHECKPOINT_REVISION=kn-ft-v1

# Who decides on the caller's words: keyword (rules, no model) or laya (the checkpoint above,
# exported to ONNX; needs `uv sync --group laya` in backend/). LAYA_CHECKPOINT_REPO may also be
# a local directory with the same layout, for trying an export before it is uploaded.
DECIDER=laya
# Docker only: 1 builds the backend image with the Laya runtime, for DECIDER=laya (docs/runbook.md).
LAYA=1
# ONNX Runtime threads; 8 was fastest on the Core Ultra 7 155H (docs/decisions/laya-latency.md)
LAYA_THREADS=8

# Backend
# Pages that may open the sockets (/ws/call, /ws/console), comma-separated: scheme, host and
# port, as the browser sends them in Origin. Add the tunnel's https address before sharing it.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Calls streaming to Prisma at once, on our Gnani key; one more is refused with "the line is
# busy". Counted per backend process.
MAX_STT_SESSIONS=2
# Of those, how many one caller (IP address) may hold at once; 0 turns the limit off.
MAX_SESSIONS_PER_CLIENT=1
# The credit ceiling (docs/runbook.md). Minutes on the line across all callers in a rolling 24
# hours, and calls one caller may start in a rolling hour; past them new calls are refused until
# they roll off or the backend restarts. 0 turns either off.
MAX_CALL_MINUTES_PER_DAY=240
MAX_CALLS_PER_CLIENT_PER_HOUR=30
# Audio a session must send, as a share of real time, not to count as silent; the phone page sends
# 1.0 all the time. 0 lets any audio at all count.
MIN_AUDIO_SHARE=0.25
# The raw transcription relay, /ws/stt. No page uses it; true only for trying Prisma by hand.
STT_RELAY_ENABLED=false
# Largest WebSocket frame the backend takes from anyone, in bytes (Docker only; the phone page
# sends about 640). Larger closes the socket.
WS_MAX_FRAME_BYTES=65536
# Shared secret the supervisor console sends before it may watch or take over calls; long and
# random. Empty turns the console socket off.
CONSOLE_TOKEN=
# true refuses the console socket and API through the Cloudflare tunnel, whatever the token, so
# officers must use this machine (docs/runbook.md). Callers are not affected.
CONSOLE_LOCAL_ONLY=false
# Consoles signed in at once, and console sockets yet to say hello: in all, and from one caller.
MAX_CONSOLES=8
MAX_CONSOLE_HELLOS=16
MAX_CONSOLE_HELLOS_PER_CLIENT=2
# Officer lines that may wait to be spoken on one call; each spends Timbre credits.
MAX_OFFICER_LINES_QUEUED=5
DATABASE_URL=sqlite:///./dhwani.db
TRANSCRIPT_RETENTION_DAYS=7
# A ticket's location_text (the caller's own words) is blanked after this many days.
TICKET_LOCATION_RETENTION_DAYS=30
